{
  "name": "rescue-box",
  "version": "1.0.0",
  "description": "⏰ Update a gist to contain your daily RescueTime stats",
  "author": "Josh Ghent <me@joshghent>",
  "license": "ISC",
  "main": "index.js",
  "repository": {
    "url": "https://github.com/joshghent/rescue-box",
    "type": "git"
  },
  "scripts": {
    "start": "node index.js",
    "lint": "oxlint",
    "test": "node --test --experimental-test-coverage --test-coverage-lines=75 --test-coverage-exclude='test/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "change-case": "^5.4.4",
    "dotenv": "^17.4.2",
    "moment": "~2.31.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "oxlint": "^1.95.0",
    "prettier": "^3.9.6",
    "pretty-quick": "^4.2.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "overrides": {
    "picomatch": "~4.0.4"
  }
}
